# ---------------------------------------------------------------
# 构建目录（CMake / Ninja / make / Qt Creator 的默认输出目录）
# ---------------------------------------------------------------
build/
build-*/
*-build/
out/
cmake-build-*/

# ---------------------------------------------------------------
# Qt Creator / Qt 工程文件（含本地套件配置，不能进版本库）
# ---------------------------------------------------------------
CMakeLists.txt.user
CMakeLists.txt.user.*
*.pro.user
*.pro.user.*
*.qmlproject.user
*.qmlproject.user.*
*.qbs.user
*.qbs.user.*

# ---------------------------------------------------------------
# CMake / qmake 生成物
# ---------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
CMakeUserPresets.json
Makefile
qmake.stash
.qmake.stash
*.ninja
.ninja_deps
.ninja_log
.qtc_clangd/
compile_commands.json

# ---------------------------------------------------------------
# 编译产物
# ---------------------------------------------------------------
*.o
*.obj
*.so
*.so.*
*.dll
*.dylib
*.a
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.exe
*.app
*.dSYM/
*.debug

# ---------------------------------------------------------------
# Qt 自动生成的文件（moc / uic / rcc）
# ---------------------------------------------------------------
moc_*.cpp
moc_*.h
moc_predefs.h
ui_*.h
qrc_*.cpp
*.moc
*_autogen/

# ---------------------------------------------------------------
# 调试 / 部署 / 编辑器杂项
# ---------------------------------------------------------------
*.log
/dist/
/deploy/
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
